<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifest van de Outlook-invoegtoepassing "Bruinsma Copilot-prompts".
  Verhoog <Version> bij elke wijziging aan dit bestand; Outlook haalt het manifest dan opnieuw op.
  Wijzigingen aan de prompts (prompts.json) of het paneel hebben geen nieuwe versie nodig.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>0376a514-c620-4d33-ae19-844e5ad9fa17</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Bruinsma Kantoor en ICT</ProviderName>
  <DefaultLocale>nl-NL</DefaultLocale>
  <DisplayName DefaultValue="Bruinsma Copilot-prompts"/>
  <Description DefaultValue="Kant-en-klare prompts voor Microsoft 365 Copilot in Outlook: mails samenvatten, beantwoorden, opstellen en je agenda voorbereiden."/>
  <IconUrl DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/"/>
  <AppDomains>
    <AppDomain>https://cursus.bruinsma-ict.nl</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <!-- De laagste rechten: het paneel leest of wijzigt geen mail. -->
  <Permissions>Restricted</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <!-- Een mail lezen -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="bru.groep.lezen">
                  <Label resid="Groep.Label"/>
                  <Control xsi:type="Button" id="bru.knop.lezen">
                    <Label resid="Knop.Label"/>
                    <Supertip>
                      <Title resid="Knop.Label"/>
                      <Description resid="Knop.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icoon.16"/>
                      <bt:Image size="32" resid="Icoon.32"/>
                      <bt:Image size="80" resid="Icoon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Paneel.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Een mail schrijven of beantwoorden -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="bru.groep.schrijven">
                  <Label resid="Groep.Label"/>
                  <Control xsi:type="Button" id="bru.knop.schrijven">
                    <Label resid="Knop.Label"/>
                    <Supertip>
                      <Title resid="Knop.Label"/>
                      <Description resid="Knop.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icoon.16"/>
                      <bt:Image size="32" resid="Icoon.32"/>
                      <bt:Image size="80" resid="Icoon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Paneel.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Een afspraak plannen -->
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="bru.groep.organisator">
                  <Label resid="Groep.Label"/>
                  <Control xsi:type="Button" id="bru.knop.organisator">
                    <Label resid="Knop.Label"/>
                    <Supertip>
                      <Title resid="Knop.Label"/>
                      <Description resid="Knop.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icoon.16"/>
                      <bt:Image size="32" resid="Icoon.32"/>
                      <bt:Image size="80" resid="Icoon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Paneel.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Een afspraak bekijken -->
            <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="bru.groep.deelnemer">
                  <Label resid="Groep.Label"/>
                  <Control xsi:type="Button" id="bru.knop.deelnemer">
                    <Label resid="Knop.Label"/>
                    <Supertip>
                      <Title resid="Knop.Label"/>
                      <Description resid="Knop.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icoon.16"/>
                      <bt:Image size="32" resid="Icoon.32"/>
                      <bt:Image size="80" resid="Icoon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Paneel.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icoon.16" DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/assets/icon-16.png"/>
          <bt:Image id="Icoon.32" DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/assets/icon-32.png"/>
          <bt:Image id="Icoon.80" DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Paneel.Url" DefaultValue="https://stanfv.github.io/Copilot-Portaal-Extension/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Groep.Label" DefaultValue="Bruinsma"/>
          <bt:String id="Knop.Label" DefaultValue="Copilot-prompts"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Knop.Tip" DefaultValue="Open de promptbibliotheek van Bruinsma: kant-en-klare prompts voor Copilot in Outlook."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
